{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Information" }
  },

  // DEVELOPMENT ONLY.
  //
  // Committed deliberately so the project runs with one command after cloning.
  // It is worthless: it signs tokens for a local database of fake data.
  // Production reads Jwt__SigningKey from the environment and refuses to start
  // if it is missing or shorter than 32 characters.
  "Jwt": {
    "SigningKey": "dev-only-insecure-signing-key-change-me-0123456789"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
