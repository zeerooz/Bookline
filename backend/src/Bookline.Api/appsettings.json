{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SigningKey": "",
    "Issuer": "bookline",
    "Audience": "bookline-web",
    "AccessTokenMinutes": 60
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "ApiPerMinute": 300,
    "PublicPerMinute": 60
  },
  "Payments": {
    "Provider": "fake",
    "StripeSecretKey": "",
    "StripeWebhookSecret": "",
    "SuccessUrl": "http://localhost:8081/booking/{token}",
    "CancelUrl": "http://localhost:8081/booking/{token}?cancelled=1"
  },
  "Notifications": {
    "EmailProvider": "log",
    "FromAddress": "no-reply@bookline.app",
    "ReminderLeadMinutes": 1440,
    "DispatchIntervalSeconds": 15,
    "MaxAttempts": 5
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
