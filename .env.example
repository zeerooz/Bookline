# Copy to .env before running docker compose.
#
# Generate a signing key:
#   openssl rand -base64 48
#
# The API refuses to start if JWT_SIGNING_KEY is missing or shorter than 32
# characters. That is deliberate: a weak key means forgeable access tokens.

JWT_SIGNING_KEY=
POSTGRES_PASSWORD=bookline
WEB_PORT=8081

# Payments: "fake" needs no account and simulates a successful checkout.
# Switch to "stripe" and fill in the test-mode keys to use the real gateway.
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: "log" writes messages to the API log. "smtp" actually sends.
EMAIL_PROVIDER=log
